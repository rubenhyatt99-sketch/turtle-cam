# --- Authentification du portail -------------------------------------------
# Liste d'utilisateurs "login:hash_bcrypt", séparés par des virgules.
# Générer un hash : node turtle-portal/agent/scripts/hash-password.mjs 'monMotDePasse'
PORTAL_USERS=ruben:$2b$12$remplace_moi_par_un_vrai_hash

# Secret de signature des sessions (32+ caractères aléatoires)
# openssl rand -base64 48
SESSION_SECRET=

# Durée de session en heures
SESSION_TTL_HOURS=72

# --- Google Drive -----------------------------------------------------------
# Clé JSON du compte de service, encodée en base64 :
# base64 -w0 service-account.json
GOOGLE_SERVICE_ACCOUNT_B64=

# ID du dossier Drive racine partagé avec le compte de service
DRIVE_ROOT_FOLDER_ID=

# --- Optionnel --------------------------------------------------------------
# Fuseau utilisé pour les regroupements par jour
TIMEZONE=Europe/Paris
